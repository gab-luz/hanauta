#!/usr/bin/env bash
set -euo pipefail

LOG_FILE="${XDG_RUNTIME_DIR:-/tmp}/hanauta-lock.log"
{
  echo "[$(date '+%F %T')] lock start"
  echo "DISPLAY=${DISPLAY:-<empty>} XAUTHORITY=${XAUTHORITY:-<empty>}"
} >>"$LOG_FILE" 2>&1

if [[ -x "$HOME/.config/i3/hanauta/bin/hanauta-service" ]]; then
  echo "trying hanauta-service --lock" >>"$LOG_FILE" 2>&1
  if "$HOME/.config/i3/hanauta/bin/hanauta-service" --lock >>"$LOG_FILE" 2>&1; then
    echo "hanauta-service path success" >>"$LOG_FILE" 2>&1
    exit 0
  fi
  echo "hanauta-service path failed, falling back to i3lock" >>"$LOG_FILE" 2>&1
fi

# Fallback to i3lock with a simple color
exec i3lock -c 000000 >>"$LOG_FILE" 2>&1